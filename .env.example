# ─────────────────────────────────────────────────────────────────────────────
# Inkest Environment Configuration — Self-Hosted Standalone Instance
# ─────────────────────────────────────────────────────────────────────────────

INKEST_DEPLOYMENT_ENV=self-hosted

# Public App URL & Authentication Secret
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_a_secure_random_32_byte_secret

# AI Security & Key Encryption (AES-256-GCM for user BYOK keys in DB)
# Generate with: openssl rand -base64 32
AI_CREDENTIAL_ENCRYPTION_KEYS=2026-09:replace_with_base64_32_byte_key

# Storage: Local filesystem directory inside container
ATTACHMENT_STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=/app/storage

# Database:
# In the all-in-one container, embedded PostgreSQL + pgvector is initialized and
# managed automatically (persisted in /data volume). No DATABASE_URL is needed.
# If connecting to an external database instead, uncomment below:
# DATABASE_URL=postgres://user:password@localhost:5432/inknest

# Cache:
# Uses built-in in-memory LRU cache with TTL by default.
# If connecting to an external Redis instance instead, uncomment below:
# REDIS_URL=redis://localhost:6379/0
