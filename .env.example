# Copy to .env.local and fill in.

# Database (local libSQL for dev; switch to Turso remote for prod)
DATABASE_URL=file:./data/local.db
DATABASE_AUTH_TOKEN=

# Auth.js and the public URL used for metadata
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Deployment environment & Cloud Admin management (defaults to self-hosted)
# Set to 'cloud' (or INKEST_CLOUD=true) to enable user management for instance admins.
# Leave unset or 'self-hosted' for standard single-tenant self-hosted isolation.
INKEST_DEPLOYMENT_ENV=self-hosted
# Comma-separated list of administrative email addresses (effective in cloud mode)
ADMIN_EMAILS=


# Required before a user saves an AI key or connects Google Calendar. The first
# id:base64-encoded 32-byte key encrypts new credentials; retain old keys after
# it (comma-separated) during rotation. Generate with: openssl rand -base64 32
AI_CREDENTIAL_ENCRYPTION_KEYS=

# Local filesystem attachment storage
ATTACHMENT_STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=20
ALLOWED_UPLOAD_TYPES=image/png,image/jpeg,image/webp,image/gif,image/svg+xml,application/pdf,application/epub+zip,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# AI (OpenAI-compatible). Leave provider API keys empty to exercise the unavailable-provider state.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENCODE_API_KEY=
OPENCODE_MODEL=
OPENCODE_BASE_URL=
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1
# Comma-separated HTTPS origins that users may select as personal custom AI
# endpoints (for example, https://ai.example.com). Instance-level provider
# URLs remain operator-controlled and may point to private infrastructure.
AI_ALLOWED_BASE_URLS=

# Google Calendar OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Telegram notifications and webhook verification. When TELEGRAM_BOT_TOKEN is
# set, TELEGRAM_WEBHOOK_SECRET is required and must also be sent to Telegram's
# setWebhook API as secret_token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Optional privacy-safe diagnostics. Errors are always structured in container
# stderr; set this HTTPS operator-owned endpoint to receive alert webhooks.
# The token is sent only as an Authorization bearer credential.
DIAGNOSTICS_WEBHOOK_URL=
DIAGNOSTICS_WEBHOOK_TOKEN=
# Retain diagnostic logs/webhook records for this many days (1-365).
DIAGNOSTICS_RETENTION_DAYS=30

# Optional private S3-compatible attachment storage
# ATTACHMENT_STORAGE_DRIVER=minio
MINIO_ENDPOINT=
MINIO_BUCKET=
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Billing: crypto payments that settle to the operator's wallet. Leave
# BILLING_PROVIDER unset to disable payments entirely.
#   cryptomus — hosted gateway; users pay on the Cryptomus checkout page and a
#     signed webhook confirms the payment. Set your payout (settlement) wallet
#     in the Cryptomus dashboard; requires CRYPTOMUS_API_KEY (and
#     CRYPTOMUS_MERCHANT_ID for business accounts).
#   manual — show BILLING_MANUAL_WALLET_ADDRESS to users; they transfer
#     directly and submit the tx hash; an admin confirms in Billing.
BILLING_PROVIDER=
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_API_KEY=
# Asset/network users are asked to pay in (e.g. USDT on tron). Leave the asset
# empty to let the gateway checkout offer every supported coin.
BILLING_PAYMENT_ASSET=USDT
BILLING_PAYMENT_NETWORK=tron
# Manual driver: the wallet shown to payers (public information).
BILLING_MANUAL_WALLET_ADDRESS=
BILLING_MANUAL_WALLET_NETWORK=tron
BILLING_MANUAL_WALLET_ASSET=USDT
# Credit economics and limits (credits are the app's spendable balance).
BILLING_CREDITS_PER_USD=100
BILLING_MIN_TOPUP_USD=5
BILLING_MAX_TOPUP_USD=500
BILLING_INVOICE_LIFETIME_MINUTES=60
