# ─────────────────────────────────────────────────────────────────────────────
# Inkest Environment Configuration — Multi-Tenant Cloud SaaS
# ─────────────────────────────────────────────────────────────────────────────

INKEST_DEPLOYMENT_ENV=cloud

# Comma-separated list of global platform administrators
ADMIN_EMAILS=admin@inkest.app,ops@inkest.app

# Public Cloud SaaS Domain & Auth
NEXTAUTH_URL=https://app.inkest.app
NEXTAUTH_SECRET=replace_with_a_production_random_32_byte_secret

# PostgreSQL + pgvector (Local Docker Compose or Dedicated Instance)
POSTGRES_USER=inknest
POSTGRES_PASSWORD=inknest_secret
POSTGRES_DB=inknest
POSTGRES_PORT=5432

# Primary Database Connection URL
# For Docker Compose: postgres://inknest:inknest_secret@postgres:5432/inknest
# For Clustered / Managed Cloud (AWS Aurora / Supabase / Neon / Cloud SQL):
# DATABASE_URL=postgres://inkest_app:strong_password@postgres-cluster.internal:5432/inknest_prod?sslmode=require
DATABASE_URL=postgres://inknest:inknest_secret@postgres:5432/inknest

# Redis / Valkey (Session Caching, Sliding Rate Limiting, Queues)
REDIS_PORT=6379
# For Docker Compose: redis://redis:6379/0
# For Clustered / Managed Redis: redis://:redis_password@redis-cluster.internal:6379/0
REDIS_URL=redis://redis:6379/0

# Object Storage / Attachments (MinIO / S3 / Cloudflare R2)
# Driver options: 'local' (local disk storage) or 'minio' (S3-compatible object storage)
ATTACHMENT_STORAGE_DRIVER=minio
LOCAL_STORAGE_ROOT=/app/storage

# MinIO Local Container Credentials & Ports (Used by docker-compose --profile storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# S3 / MinIO Connection Settings
# For Docker Compose local MinIO container:
# MINIO_ENDPOINT=http://minio:9000
# MINIO_BUCKET=inkest-attachments
# MINIO_REGION=us-east-1
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
#
# For Cloudflare R2 / AWS S3:
MINIO_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
MINIO_BUCKET=inkest-cloud-attachments
MINIO_REGION=auto
MINIO_ACCESS_KEY=your_r2_access_key_id
MINIO_SECRET_KEY=your_r2_secret_access_key

# Key Ring for Encrypting User Stored BYOK Keys (AES-256-GCM)
# Generate with: openssl rand -base64 32
AI_CREDENTIAL_ENCRYPTION_KEYS=2026-09:replace_with_base64_32_byte_key

# Default Platform AI Provider & LLM Model (Users can override with their own BYOK in Settings)
# Options for AI_PROVIDER: 'openai', 'openrouter', 'opencode', 'ollama', 'nvidia', 'custom'
AI_PROVIDER=openrouter
AI_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Billing & Payments (NexaPay: Card & Crypto Settlement / Manual)
BILLING_PROVIDER=nexapay
NEXAPAY_API_KEY=your_nexapay_api_key
NEXAPAY_API_SECRET=your_nexapay_api_secret
NEXAPAY_WEBHOOK_SECRET=your_nexapay_webhook_secret
NEXAPAY_BASE_URL=https://api.nexapay.one
BILLING_CREDITS_PER_USD=100
BILLING_MIN_TOPUP_USD=5
BILLING_MAX_TOPUP_USD=500
BILLING_PAYMENT_ASSET=USDT
BILLING_PAYMENT_NETWORK=tron

# Telegram Bot (Cloud Shared Webhook)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Google Calendar Integration (OAuth Client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
